# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=lumina_db

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=password
PG_DATABASE=lumina_db

# Jira Configuration
JIRA_DOMAIN=your_jira_domain
JIRA_EMAIL=your_jira_email
JIRA_API_TOKEN=your_jira_api_token

# Trello Configuration
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_TOKEN=your_trello_api_token

# OpenProject Configuration
OPENPROJECT_DOMAIN=your_openproject_domain.com
OPENPROJECT_API_KEY=your_openproject_api_key

# ClickUp Configuration
CLICKUP_API_TOKEN=your_clickup_personal_api_token

# GitHub Configuration (Version Control)
GITHUB_TOKEN=your_github_personal_access_token

# Gitea Configuration (Version Control, self-hosted)
# Full base URL of your Gitea instance, including scheme and port if non-standard.
GITEA_BASE_URL=https://gitea.example.com:3000
GITEA_TOKEN=your_gitea_access_token
